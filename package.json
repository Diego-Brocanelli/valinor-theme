    "scripts": {
        "build": "node ./src/build.js",
        "validate": "node ./src/validate.js",
        "watch": "nodemon --watch src --ext yml,js --exec \"npm run build\"",
        "package": "node -e \"require('fs').mkdirSync('bin',{recursive:true})\" && vsce package -o ./bin/valinor-theme.vsix",
        "vscode:prepublish": "npm run build",
        "vsce-publish": "vsce publish",
        "screenshots": "node ./src/screenshots.js",
        "vendor:lucide": "node ./src/vendor-lucide.js",
        "vendor:product-icons": "node ./src/vendor-product-icons.js",
        "site": "node ./src/site.js",
        "italic": "node ./src/lib/italic.js"
    },
